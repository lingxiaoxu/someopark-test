<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd schedule for the unattended daily prediction refresh + deploy.
  Runs refresh_and_deploy.sh once a day at 06:30 local time (after the day's
  matches finish). Contains NO secrets — the script loads FIREBASE_TOKEN and the
  API keys from the gitignored .env files.

  Install:
    cp prediction_market/ops/com.someopark.predictionrefresh.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.someopark.predictionrefresh.plist
  Run once now to test:
    launchctl start com.someopark.predictionrefresh
  Disable:
    launchctl unload ~/Library/LaunchAgents/com.someopark.predictionrefresh.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.someopark.predictionrefresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/xuling/code/someopark-test/prediction_market/ops/refresh_and_deploy.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>6</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/xuling/code/someopark-test/prediction_market/data/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/xuling/code/someopark-test/prediction_market/data/logs/launchd.err.log</string>
</dict>
</plist>
