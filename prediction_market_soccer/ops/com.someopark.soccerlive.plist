<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  In-play refresh every 60s via live_refresh.sh (12-comp budget pacing, plan §6.1), which is a cheap gate:
  outside a match window it's a single DB query (no API, no writes); inside a window
  it pulls live fixture state (API-Football) and regenerates inplay_live.json +
  upcoming.json into public/data. The local Express server serves public/data over
  the Cloudflare tunnel, so the live site (someopark.web.app) updates every minute
  WITHOUT a Firebase redeploy — the frontend polls inplay_live.json every 30s.

  Requires the tunnel + server to be up (see TUNNEL_GUIDE.md):
    npm run server    &&    cloudflared tunnel --url http://localhost:3001 ...

  Install:
    cp prediction_market_soccer/ops/com.someopark.soccerlive.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.someopark.soccerlive.plist
  Disable:
    launchctl unload ~/Library/LaunchAgents/com.someopark.soccerlive.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.someopark.soccerlive</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/xuling/code/someopark-test/prediction_market_soccer/ops/live_refresh.sh</string>
  </array>
  <!-- 60s cadence (club edition: 12 comps share the API budget; in-poll governor sheds extras at high usage) for in-play ¢ + milestone capture (plan 18 P8). Outside a
       match window live_refresh is a cheap 1-query no-op, so this only does real work
       during matches; Kalshi reads are free, Poly US reads stay within the API budget. -->
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/xuling/code/someopark-test/prediction_market_soccer/data/logs/live.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/xuling/code/someopark-test/prediction_market_soccer/data/logs/live.err.log</string>
</dict>
</plist>
