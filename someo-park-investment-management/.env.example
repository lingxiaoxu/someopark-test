# API Server
API_PORT=3001
BACKEND_ROOT=..

# MongoDB
MONGO_URI=mongodb://user:pass@host:port/db

# ===== AI Chat Platform Keys =====

# E2B API Key - Required for code execution sandbox (https://e2b.dev)
E2B_API_KEY=

# Anthropic API Key (Claude models)
ANTHROPIC_API_KEY=

# OpenAI API Key (GPT models) - optional, users can input their own
OPENAI_API_KEY=

# Google AI API Key (Gemini models)
GOOGLE_AI_API_KEY=

# HuggingFace Token (optional)
HF_TOKEN=

# Hyperbolic API Key (optional)
HYPERBOLIC_API_KEY=

# NOTE: This is a Vite app — only VITE_-prefixed vars reach the frontend.
# The Morph-Apply default (ON) and model-picker contents are set in code
# (src/App.tsx + src/lib/models.json), NOT via env. The old NEXT_PUBLIC_*
# Morph/hide-models flags were Next.js leftovers and are ignored — removed.

# Open-source model via Ollama host (OpenAI-compatible /v1 path). Optional.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Morph API Key (https://morphllm.com) — code fast-apply engine
MORPH_API_KEY=

# Supabase (auth + chat history) — VITE_ prefix for frontend access
VITE_ENABLE_SUPABASE=true
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Firebase (Firestore for VPS bot commands)
VITE_FIREBASE_API_KEY=
